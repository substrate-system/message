{
  "name": "@substrate-system/message",
  "version": "0.11.7",
  "type": "module",
  "description": "Create and verify signed messages",
  "files": [
    "./dist/*"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js,mjs}\"",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "build-tests": "esbuild ./test/index.ts --bundle --outfile=./test/test-bundle.js",
    "test:node": "npm run build-tests && node ./test/test-bundle.js",
    "test:browser": "npm run build-tests && tapout < ./test/test-bundle.js",
    "test:package": "npm run build && node ./test/package.mjs",
    "test:readme": "npm run build && node ./test/readme.mjs",
    "test": "npm run typecheck && npm run test:node && npm run test:browser && npm run test:package && npm run test:readme",
    "build-cjs": "esbuild src/*.ts --format=cjs --keep-names --outdir=./dist --out-extension:.js=.cjs",
    "build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && tsc --project tsconfig.build.json",
    "preversion": "npm run lint",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@substrate-system/json-canon": "^0.1.3",
    "@substrate-system/keys": "^0.2.43",
    "@substrate-system/one-webcrypto": "^1.1.3",
    "uint8arrays": "^5.1.1"
  },
  "devDependencies": {
    "@substrate-system/tapout": "^0.0.41",
    "@substrate-system/tapzero": "^0.10.16",
    "auto-changelog": "^2.4.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "markdown-toc": "^1.2.0",
    "newneostandard": "^0.14.1",
    "tap-spec": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": [
        "./dist/*.js",
        "./dist/*"
      ],
      "require": [
        "./dist/*.cjs",
        "./dist/*"
      ]
    }
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrate-system/message.git"
  },
  "keywords": [
    "message"
  ],
  "bugs": {
    "url": "https://github.com/substrate-system/message/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)",
  "homepage": "https://github.com/substrate-system/message#readme"
}
